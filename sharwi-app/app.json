{
  "expo": {
    "name": "Sharwi",
    "slug": "sharwi-app",
    "scheme": "sharwi",
    "version": "0.1.0",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0B0B0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sharwi.app"
    },
    "android": {
      "package": "com.sharwi.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": ""
    }
  }
}
