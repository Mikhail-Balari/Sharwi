{
  "name": "sharwi-landing",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "sharwi-app",
    "sharwi-backend"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:landing": "next dev",
    "dev:mobile": "npm --workspace sharwi-app run start -- --port 8083 --clear",
    "dev:mobile:tunnel": "npm --workspace sharwi-app run start -- --port 8083 --tunnel --clear",
    "dev:backend": "npm --workspace sharwi-backend run dev",
    "build": "next build",
    "build:landing": "next build",
    "build:backend": "npm --workspace sharwi-backend run build",
    "typecheck:mobile": "npm --workspace sharwi-app run typecheck",
    "start": "next start",
    "start:backend": "npm --workspace sharwi-backend run start",
    "lint": "next lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/analytics": "^1.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.462.0",
    "next": "15.5.15",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.38.0",
    "eslint-config-next": "15.5.15",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
